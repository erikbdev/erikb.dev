{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "swift",
      "request": "launch",
      "name": "Launch SiteSSHServer",
      "program": "${workspaceRoot}/.build/debug/SiteSSHServer",
      "args": [],
      "env": {},
      "cwd": "${workspaceRoot}",
      "preLaunchTask": "swift: Build Debug SiteSSHServer"
    },
    {
      "type": "swift",
      "request": "launch",
      "name": "Launch SiteServer",
      "program": "${workspaceRoot}/.build/debug/SiteServer",
      "args": [],
      "env": {},
      "cwd": "${workspaceRoot}",
      "preLaunchTask": "swift: Build Debug SiteServer"
    },
    {
      "type": "node-terminal",
      "name": "Run Script: dev:web",
      "request": "launch",
      "command": "pnpm run dev:web",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Local:    (.*)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/src",
        "killOnServerStop": true
      }
    }
  ]
}
